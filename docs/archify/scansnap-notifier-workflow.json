{
  "schema_version": 1,
  "diagram_type": "workflow",
  "meta": {
    "title": "ScanSnap Notifier Flow",
    "quality_profile": "showcase",
    "locale": "en"
  },
  "lanes": [
    { "id": "setup", "label": "Setup" },
    { "id": "runtime", "label": "GAS" },
    { "id": "drive", "label": "Google Drive" },
    { "id": "notify", "label": "Notification channels" },
    { "id": "exceptions", "label": "Exception handling", "variant": "exception" }
  ],
  "mainPath": ["trigger", "check", "drive", "newfile", "discord", "line", "commit"],
  "nodes": [
    { "id": "props", "lane": "setup", "col": 2, "type": "database", "label": "Script Properties", "sublabel": "FOLDER_ID / targets / state", "width": 125 },
    { "id": "setconfig", "lane": "setup", "col": 0, "type": "backend", "label": "setConfig()", "sublabel": "init + trigger", "tag": "manual, first run only" },
    { "id": "trigger", "lane": "runtime", "col": 0, "type": "cloud", "label": "Time trigger", "sublabel": "every 5 min" },
    { "id": "check", "lane": "runtime", "col": 1, "type": "backend", "label": "checkForNewFiles()", "sublabel": "lock + config check", "tag": "LockService", "width": 130 },
    { "id": "drive", "lane": "drive", "col": 2, "type": "cloud", "label": "Google Drive v3", "sublabel": "ScanSnap source folder", "width": 112 },
    { "id": "newfile", "lane": "drive", "col": 3, "type": "backend", "label": "Scan new files", "sublabel": "skip dupes via PROCESSED_IDS", "width": 120 },
    { "id": "discord", "lane": "notify", "col": 4, "type": "external", "label": "Discord", "sublabel": "Webhook embed post", "brand": "discord", "width": 115 },
    { "id": "line", "lane": "notify", "col": 5, "type": "external", "label": "LINE", "sublabel": "Messaging API push", "width": 108 },
    { "id": "skip", "lane": "exceptions", "col": 1, "type": "security", "label": "Lock conflict", "sublabel": "skip on duplicate" },
    { "id": "error", "lane": "exceptions", "col": 4, "type": "security", "label": "Send error", "sublabel": "resent next run" },
    { "id": "commit", "lane": "runtime", "col": 5, "type": "backend", "label": "Commit state", "sublabel": "state saved on success" }
  ],
  "edges": [
    { "id": "e-trigger-check", "from": "trigger", "to": "check", "label": "fires every 5 min", "variant": "emphasis", "role": "main", "fromSide": "bottom", "toSide": "bottom", "route": "bottom-channel", "channelY": 290, "labelDy": 18 },
    { "id": "e-setconfig-trigger", "from": "setconfig", "to": "trigger", "label": "installTrigger()", "variant": "dashed", "role": "branch", "labelAt": [160, 200] },
    { "id": "e-setconfig-props", "from": "setconfig", "to": "props", "label": "baseline init", "variant": "dashed", "role": "branch", "fromSide": "bottom", "toSide": "bottom", "route": "bottom-channel", "labelAt": [275, 200] },
    { "id": "e-check-props", "from": "check", "to": "props", "label": "read LAST_CHECK", "variant": "dashed", "role": "branch" },
    { "id": "e-check-drive", "from": "check", "to": "drive", "label": "Drive v3 query", "role": "main", "fromSide": "right", "toSide": "top", "labelAt": [345, 325] },
    { "id": "e-drive-newfile", "from": "drive", "to": "newfile", "label": "new file list", "role": "main", "fromSide": "top", "toSide": "top", "route": "up-channel", "channelY": 290 },
    { "id": "e-newfile-discord", "from": "newfile", "to": "discord", "label": "notify new file", "role": "main" },
    { "id": "e-discord-line", "from": "discord", "to": "line", "label": "also to LINE", "role": "main", "fromSide": "bottom", "toSide": "bottom", "route": "bottom-channel", "channelY": 535 },
    { "id": "e-line-commit", "from": "line", "to": "commit", "label": "send OK", "role": "main" },
    { "id": "e-check-skip", "from": "check", "to": "skip", "label": "lock not acquired", "variant": "security", "role": "error", "route": "straight", "labelAt": [220, 470] },
    { "id": "e-discord-error", "from": "discord", "to": "error", "label": "send failed", "variant": "security", "role": "error", "labelAt": [500, 560] },
    { "id": "e-line-error", "from": "line", "to": "error", "label": "send failed", "variant": "security", "role": "error" }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "Initial setup",
      "items": [
        "Set FOLDER_ID and notify targets in Script Properties",
        "Run setConfig() to save the baseline (current time)",
        "Existing files are not notified; only later new files",
        "Registers exactly one trigger at a 5-minute interval"
      ]
    },
    {
      "dot": "emerald",
      "title": "Reliability design",
      "items": [
        "LockService prevents concurrent runs",
        "429 rate limit retried per Retry-After",
        "On send failure LAST_CHECK is not advanced, next run resends",
        "PROCESSED_IDS (max 200) prevents duplicate notifications"
      ]
    },
    {
      "dot": "violet",
      "title": "Notification channels",
      "items": [
        "Discord: embed post via Webhook (created time, size, link)",
        "LINE: push via Messaging API (max 5 per run)",
        "Either channel alone, or both at once",
        "validateSetup() diagnoses missing notifications"
      ]
    }
  ]
}
