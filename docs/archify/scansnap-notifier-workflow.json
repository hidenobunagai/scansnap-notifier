  "cards": [
    {
      "dot": "cyan",
      "title": "初回セットアップ",
      "items": [
        "Script Properties に FOLDER_ID と通知先を設定",
        "setConfig() 実行でベースライン（現在時刻）を保存",
        "既存ファイルは通知せず、以後の新規のみ通知",
        "5 分間隔のトリガーが 1 つだけ登録される"
      ]
    },
    {
      "dot": "emerald",
      "title": "信頼性設計",
      "items": [
        "LockService で重複実行を防止",
        "429 レートリミットは Retry-After に従い再試行",
        "通知失敗時は LAST_CHECK を進めず、次回実行で再送",
        "PROCESSED_IDS（最大200件）で二重通知を防止"
      ]
    },
    {
      "dot": "violet",
      "title": "通知チャネル",
      "items": [
        "Discord: Webhook で embed 投稿（作成日時・サイズ・リンク）",
        "LINE: Messaging API で push 送信（最大 5 件/回）",
        "どちらか一方のみ・両方同時のどちらも利用可能",
        "validateSetup() で通知未達の原因を診断"
      ]
    }
  ]
